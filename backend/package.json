{
  "name": "tranquille-vacances-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.js",
    "dev:wrangler": "wrangler dev --local --ip 0.0.0.0",
    "dev:remote": "wrangler dev",
    "tunnel": "npx cloudflared tunnel --url http://localhost:8787",
    "thumbs": "node --no-warnings scripts/gen-thumbnails.js",
    "thumbs:apply": "node --no-warnings scripts/gen-thumbnails.js --apply",
    "verify:galleries": "node --no-warnings scripts/verify-galleries.js",
    "tnr": "node --no-warnings tests/tnr.js",
    "tnr:rapide": "node --no-warnings tests/tnr.js --rapide",
    "deploy": "node scripts/deploy.js",
    "deploy:prod": "node scripts/deploy.js --prod",
    "deploy:force": "node scripts/deploy.js --prod --skip-tests",
    "deploy:sans-tnr": "npm run build:css && wrangler deploy --env production",
    "db:migrate": "wrangler d1 execute tranquille-vacances-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute tranquille-vacances-db --file=schema.sql",
    "db:studio": "wrangler d1 studio tranquille-vacances-db --local",
    "migrate:images": "node scripts/migrate-images.js",
    "migrate:images:remote": "node scripts/migrate-images.js --remote",
    "admin:send-setup-email": "node scripts/send-admin-setup-email.js",
    "admin:send-setup-email:remote": "node scripts/send-admin-setup-email.js --remote",
    "vapid:generate": "node scripts/generate-vapid.js",
    "tail": "wrangler tail",
    "build:css": "tailwindcss -i ./src/tailwind-input.css -o ./public/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind-input.css -o ./public/tailwind.css --watch"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.94.0"
  },
  "dependencies": {
    "docx": "^9.7.1"
  }
}
